# Environment variables for local development
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Application
APP_DEBUG=true
APP_NAME=Ocktova
SESSION_TIMEOUT_SECONDS=1800

# Database driver: 'mysql' or 'pgsql' (PostgreSQL)
DB_DRIVER=pgsql

# Database (for local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=corporate_site
DB_USER=postgres
DB_PASS=postgres
DB_CHARSET=utf8

# For Render deployment, these will be automatically provided by the managed PostgreSQL service
# DB_HOST= (provided by Render)
# DB_PORT= (provided by Render)
# DB_NAME= (provided by Render)
# DB_USER= (provided by Render)
# DB_PASS= (provided by Render)
# DB_DRIVER=pgsql