# Environment variables for local development
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Application
APP_DEBUG=true
APP_NAME=Ocktova
SESSION_TIMEOUT_SECONDS=1800

# Database (for local Docker/XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=corporate_site
DB_USER=db_username
DB_PASS=db_password
DB_CHARSET=utf8mb4

# For Render deployment, these will be automatically provided by the managed database service
# DB_HOST= (provided by Render)
# DB_PORT= (provided by Render)
# DB_NAME= (provided by Render)
# DB_USER= (provided by Render)
# DB_PASS= (provided by Render)